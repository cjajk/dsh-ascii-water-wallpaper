{
  "name": "@local/ascii-water-wallpaper",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 桌面壳 ASCII 水纹动态背景主题插件：全屏 ASCII 水流壁纸 + 鼠标涟漪，上层组件半透明。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjajk/dsh-ascii-water-wallpaper.git"
  },
  "homepage": "https://github.com/cjajk/dsh-ascii-water-wallpaper#readme",
  "bugs": { "url": "https://github.com/cjajk/dsh-ascii-water-wallpaper/issues" },
  "license": "MIT",
  "author": "cjajk",
  "keywords": ["dsh", "dsh-plugin", "wallpaper", "ascii", "ripple", "theme"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
